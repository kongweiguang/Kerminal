{
  "schema": 1,
  "id": "acme.notes",
  "name": {"en": "Performance Fixture"},
  "description": {"en": "Local performance acceptance workload"},
  "version": "1.0.0",
  "api": "^1.0",
  "publisher": "acme",
  "license": "MIT",
  "categories": ["productivity"],
  "runtime": {
    "kind": "sidecar",
    "main": {
      "windows-x86_64": "bin/sidecar.exe",
      "linux-x86_64": "bin/sidecar",
      "macos-x86_64": "bin/sidecar",
      "macos-aarch64": "bin/sidecar"
    },
    "activation": "on-demand"
  },
  "permissions": [],
  "contributes": {"tabs": [{"id": "notes-editor", "title": "Performance", "view": "notes.editor", "state_version": 1}]},
  "views": {"notes.editor": {"kind": "native", "file": "views/renderer.json"}}
}
