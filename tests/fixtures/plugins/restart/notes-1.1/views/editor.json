{
  "data": {
    "text": "",
    "busy": false
  },
  "root": {
    "gap": "md",
    "children": [
      {
        "type": "text",
        "text": "$marker"
      },
      {
        "bind": "text",
        "label": "%editor.text%",
        "placeholder": "%editor.placeholder%",
        "type": "textarea"
      },
      {
        "children": [
          {
            "label": "%editor.save%",
            "action": "save",
            "variant": "primary",
            "type": "button"
          },
          {
            "label": "%editor.check%",
            "action": "check",
            "busy": "$busy",
            "type": "button"
          },
          {
            "type": "button",
            "label": "%editor.copy%",
            "action": "copy"
          },
          {
            "type": "button",
            "label": "%editor.count%",
            "action": "count-code-points"
          }
        ],
        "type": "toolbar"
      },
      {
        "type": "row",
        "children": [
          {
            "type": "text",
            "text": "%editor.countResult%"
          },
          {
            "type": "text",
            "text": "$codePointCount"
          }
        ]
      }
    ],
    "type": "stack"
  },
  "schema": 1
}
