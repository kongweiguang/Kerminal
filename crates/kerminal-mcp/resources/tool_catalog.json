  "tools": [
    {
      "name": "kerminal.help",
      "title": "读取 Kerminal 使用帮助",
      "description": "统一查询当前可用工具、应用导航、配置规则和操作流程；topic 为 overview/app/config/tools/operation，默认 overview。只读，不执行动作。",
      "category": "diagnostics",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "enabled": true,
      "exposedToMcp": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "toolId": {
            "type": "string",
            "description": "精确 MCP tool id，例如 terminal.write。"
          },
          "family": {
            "type": "string",
            "description": "工具族过滤，可用于读取一组相关 tools。",
            "enum": [
              "discovery",
              "agent-session",
              "terminal",
              "ssh",
              "sftp",
              "tmux",
              "container",
              "port-forward",
              "server-info",
              "history",
              "diagnostics",
              "config",
              "credentials"
            ]
          },
          "query": {
            "type": "string",
            "description": "按工具 id、标题、描述或分类做大小写不敏感搜索。"
          },
          "includeSchemas": {
            "type": "boolean",
            "description": "是否返回 inputSchema，默认 true；false 时只返回摘要、示例和安全标注。"
          },
          "topic": {
            "type": "string",
            "enum": [
              "overview",
              "app",
              "config",
              "tools",
              "operation"
            ],
            "description": "帮助主题；指定工具筛选时默认 tools，指定 intent 时默认 operation。"
          },
          "intent": {
            "type": "string",
            "description": "操作意图，默认 overview。",
            "enum": [
              "overview",
              "terminal",
              "session-terminal",
              "ssh-command",
              "sftp",
              "tmux",
              "container",
              "port-forward",
              "server-info",
              "history",
              "config",
              "credentials",
              "diagnostics"
            ]
          },
          "goal": {
            "type": "string",
            "description": "用户目标的可选自然语言摘要；仅回显帮助 Agent 对齐上下文。"
          }
        },
        "required": []
      },
      "agentScoped": false
    },
    {
      "name": "kerminal.runtime_snapshot",
      "title": "读取 Kerminal 运行态快照",
      "description": "返回当前 Kerminal 运行态摘要：终端、Agent session、targetBinding、端口转发、本机代理入口和 MCP 工具数量，并说明外部 MCP 默认后台、headless PTY 与显式 UI Tab 的执行路径；不读取 secrets，不提供文件型配置 CRUD。",
      "category": "diagnostics",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "enabled": true,
      "exposedToMcp": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "agentScoped": false
    },
    {
      "name": "terminal.create",
      "title": "创建后台终端",
      "description": "为持久、交互或 local shell 创建可操作的 headless PTY；target=local 支持本地 shell，target=ssh 使用已保存 SSH 主机的登录 shell，返回 sessionId 供 terminal.snapshot/write/resize/close 使用，不创建 UI pane 或 Tab。外部 MCP 必须沿用该显式 sessionId；内置右栏 Agent 的 session-terminal 才可按 targetBinding 解析现有用户终端。",
      "category": "terminal",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "enabled": true,
      "exposedToMcp": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "description": "终端目标，local（默认）或 ssh。",
            "enum": [
              "local",
              "ssh"
            ]
          },
          "hostId": {
            "type": "string",
            "description": "已保存 SSH 主机 id；target=ssh 时必填，只引用保存凭据，不接收密码或私钥。"
          },
          "cwd": {
            "type": "string",
            "description": "可选工作目录；local 使用本机路径，ssh 使用远端路径。"
          },
          "shell": {
            "type": "string",
            "description": "可选 shell；仅 target=local 时生效，target=ssh 使用已保存主机的登录 shell。"
          },
          "cols": {
            "type": "number",
            "description": "可选列数，默认 120。"
          },
          "rows": {
            "type": "number",
            "description": "可选行数，默认 30。"
          },
          "agentSessionId": {
            "type": "string",
            "description": "可选 Agent session id，仅作为调用关联信息，不限制 global scope；省略时创建可供第三方 MCP 使用的全局 headless session。"
          }
        },
        "required": []
      },
      "agentScoped": false
    },
    {
      "name": "terminal.write",
      "title": "写入终端",
      "description": "向既有终端写入原始输入。外部 MCP 仅在 terminal.create 返回的 headless sessionId 或用户明确指定并确认的 UI Tab sessionId 上使用；可见输入/输出不是默认路径。内置右栏 Agent/session-terminal 仍使用 global scope 和 targetBinding 首选目标，不额外创建 Kerminal 确认步骤。",
      "category": "terminal",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "enabled": true,
      "exposedToMcp": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "外部 MCP 使用 terminal.create 后必须传回的显式 session id，或用户明确指定并确认的 UI Tab session id；内置右栏 Agent 可省略并按 targetBinding 解析，Agent session 的 scope 为 global。"
          },
          "agentSessionId": {
            "type": "string",
            "description": "Kerminal Agent session id；仅内置右栏 Agent/session-terminal 用于解析 targetBinding 和 global scope。"
          },
          "bindingGeneration": {
            "type": "number",
            "description": "兼容旧调用的可选 generation；当前 targetBinding 或显式 sessionId 路径无需提供。"
          },
          "data": {
            "type": "string",
            "description": "写入终端的原始输入。"
          }
        },
        "required": [
          "data"
        ]
      },
      "agentScoped": false
    },
