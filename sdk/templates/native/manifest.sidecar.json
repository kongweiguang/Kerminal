{
  "schema": 1,
  "id": "__PLUGIN_ID__",
  "name": {"en": "Example plugin"},
  "description": {"en": "A native Kerminal plugin with a Rust Sidecar"},
  "version": "0.1.0",
  "api": "^1.0",
  "publisher": "__PUBLISHER__",
  "runtime": {
    "kind": "sidecar",
    "main": {
      "windows-x86_64": "bin/sidecar.exe",
      "linux-x86_64": "bin/sidecar",
      "macos-x86_64": "bin/sidecar",
      "macos-aarch64": "bin/sidecar"
    },
    "activation": "on-demand"
  },
  "contributes": {"tools": [{"id": "panel", "title": "%panel.title%", "view": "panel", "scope": "tab"}]},
  "views": {"panel": {"kind": "native", "file": "views/panel.json"}},
  "l10n": "l10n"
}