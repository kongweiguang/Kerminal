# @author kongweiguang
[package]
name = "kerminal-plugin-sidecar"
version = "0.1.0"
edition = "2024"

[dependencies]
kerminal-plugin-sdk = { path = ".kerminal-sdk/sdk/rust" }
serde_json = "1"
tokio = { version = "=1.53.1", features = ["macros", "rt-multi-thread"] }

# .kerminal-sdk 必须检出作者确认的完整 SDK 提交，发布时与 CLI 使用同一 KERMINAL_SDK_REF。

# 插件仓库独立于作者放置目录中的其他 Cargo 工作区。
[workspace]
