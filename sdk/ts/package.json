{
  "name": "@kerminal/sdk",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builders": {
      "types": "./dist/builders.d.ts",
      "import": "./dist/builders.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./kerminal.css": "./kerminal.css"
  },
  "files": [
    "dist",
    "kerminal.css"
  ],
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "check:generated": "node scripts/generate-types.mjs --check",
    "build": "npm run check:generated && tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tests/tsconfig.json && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  }
}
